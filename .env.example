# Supabase project settings (publishable key is safe for browser use; this app uses it server-side too).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only for narrowly scoped privileged storage operations.
# SUPABASE_SERVICE_ROLE_KEY is accepted as a legacy fallback by the app.
SUPABASE_SECRET_KEY=

# Used to construct the temporary doctor-share URL. Set to the canonical HTTPS origin in production.
APP_BASE_URL=http://localhost:3000

# Optional OCR provider adapter. OCR remains unavailable unless all required fields are configured.
OCR_PROVIDER_ENDPOINT=
OCR_PROVIDER_API_KEY=

# Optional scheduler authentication; no reminders are sent without a delivery provider.
CRON_SECRET=
